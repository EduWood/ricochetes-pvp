{
  "manifest_version": 3,
  "name": "Ricochetes PvP",
  "version": "1.3.0",
  "minimum_chrome_version": "111",
  "description": "Previsão estimada de ricochetes na aba atual do Farm Ricochet.",
  "permissions": ["activeTab", "scripting"],
  "action": {"default_title": "Ricochetes PvP", "default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["https://farmricochet.com/play", "https://farmricochet.com/play?*", "https://farmricochet.com/play/*"],
    "js": ["bootstrap.js"],
    "run_at": "document_idle",
    "world": "MAIN"
  }]
}
